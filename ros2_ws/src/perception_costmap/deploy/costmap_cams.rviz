Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 20
      Line Style:
        Line Width: 0.03
        Value: Lines
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: CostmapRGB
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /viz/costmap_rgb
      Color Transformer: RGB8
      Style: Boxes
      Size (m): 0.1
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 1
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Front
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_front/zed_node/rgb/color/rect/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Left
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_left/zed_node/rgb/color/rect/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Right
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed_right/zed_node/rgb/color/rect/image
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 10
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 25
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
