Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz_default_plugins/Map
      Name: Fused Costmap
      Enabled: true
      Topic:
        Value: /seven_layer_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.75
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Lanelet Layer
      Enabled: false
      Topic:
        Value: /seven_layer_costmap/layers/lanelet
      Alpha: 0.55
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Static Obstacles
      Enabled: false
      Topic:
        Value: /seven_layer_costmap/layers/static_obstacle
      Alpha: 0.65
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Spatio-temporal Voxels
      Enabled: false
      Topic:
        Value: /seven_layer_costmap/layers/spatio_temporal_voxel
      Alpha: 0.65
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Prediction
      Enabled: false
      Topic:
        Value: /seven_layer_costmap/layers/prediction
      Alpha: 0.65
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Inflation
      Enabled: false
      Topic:
        Value: /seven_layer_costmap/layers/inflation
      Alpha: 0.65
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Traffic Regulation
      Enabled: false
      Topic:
        Value: /seven_layer_costmap/layers/traffic_regulation
      Alpha: 0.65
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Road Condition
      Enabled: false
      Topic:
        Value: /seven_layer_costmap/layers/road_condition
      Alpha: 0.65
      Color Scheme: costmap
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 60
Window Geometry:
  Width: 1200
  Height: 800
